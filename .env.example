# Database connection string
DATABASE_URL=postgresql://postgres@127.0.0.1:54320/your-database-name
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash.
# Local: http://localhost:3000 (or :3001 if 3000 is taken).
# Vercel Production: your canonical domain. Leave unset on Preview so VERCEL_URL is used.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
# Keep stable across builds/deploys (openssl rand -base64 32). Set on Vercel for all envs.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE
